{
  "name": "complaint-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Motor insurance complaint agent demo: n8n orchestration, TypeScript backend, Playwright RPA, mocked models",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "backend": "tsx src/server.ts",
    "legacy": "tsx legacy/server.ts",
    "rpa": "tsx rpa/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "n8n:import": "node scripts/n8n.mjs import",
    "stop": "node scripts/stop.mjs",
    "start:inprocess": "node scripts/start.mjs --no-n8n"
  },
  "dependencies": {
    "express": "5.3.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
