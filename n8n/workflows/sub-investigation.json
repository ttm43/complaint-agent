          "assignments": [
            {
              "id": "386e451a-f4bf-4d0c-abdb-60750ce1ce59",
              "name": "attempt",
              "value": "={{ $('Attempt').last().json.attempt + 1 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "dd7ef18a-6976-4cb5-ac62-fd19b399827a",
